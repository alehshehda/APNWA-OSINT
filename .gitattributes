# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.tex text eol=lf
*.bib text eol=lf
*.bst text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.eps binary

